# 배포 환경(Streamlit Community Cloud)의 Secrets에 등록할 내용
# App Settings -> Secrets에 아래 내용을 그대로 붙여넣습니다.
# secrets.toml은 gitignore 대상이므로 절대 커밋되지 않습니다.

OPENAI_API_KEY = "여기에-OpenAI-API-키-입력"

# Streamlit Community Cloud Google OAuth OIDC 인증 설정
[auth]
redirect_uri = "https://<내-앱-이름>.streamlit.app/oauth2callback"
cookie_secret = "32자-이상의-랜덤-세션암호화-비밀키"
client_id = "발급받은-클라이언트ID.apps.googleusercontent.com"
client_secret = "발급받은-클라이언트보안비밀번호"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
